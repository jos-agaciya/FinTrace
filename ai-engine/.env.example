# FinTrace AI Engine - Environment Configuration
# Copy this file to .env and populate with your API credentials.
# NEVER commit .env to version control!

# Provider Mode (Set to true to strictly require live API keys and prevent mock fallback)
FINTRACE_LIVE_MODE=false

# Groq API Configuration (Primary High-Throughput Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Secondary Provider / Independent Reviewer)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Circuit Breaker & Fallback Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60.0
AI_ENGINE_REQUEST_TIMEOUT_SECONDS=15.0
