# FinTrace AI Engine - Environment Configuration
# Copy this file to .env and populate with your API credentials.
# NEVER commit .env to version control!

# Groq API Configuration (Primary Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Configuration (Secondary / Reviewer Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Circuit Breaker & Fallback Settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60.0
AI_ENGINE_REQUEST_TIMEOUT_SECONDS=15.0
