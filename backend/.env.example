# FinTrace Backend Environment Variables
APP_NAME="FinTrace API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Database Configuration (SQLite default for MVP, compatible with PostgreSQL)
DATABASE_URL=sqlite:///./fintrace.db

# AI Provider Credentials (Keep secure, never commit real keys)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_AI_PROVIDER=groq
SECONDARY_AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT_SECONDS=15.0
AI_MAX_RETRIES=2

# CORS Settings (Comma-separated for frontend integration)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
